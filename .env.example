# SSO Configuration
# When SSO_REQUIRED=true the server rejects requests that lack SSO proxy headers
# In production (k8s) this comes from a ConfigMap; keep false for local dev
SSO_REQUIRED=false

# URL to redirect users to when not authenticated (only used client-side)
SSO_URL=

# Groups allowed to access the portal at all (pipe-separated; leave empty to allow everyone).
# Use plain group names, even if your IdP's groups claim sends full DNs
# (CN=Engineering,OU=Groups,DC=example,DC=com) — auth.ts extracts just the CN
# from the incoming header for matching, so the config side only needs the name.
# Example: ALLOWED_GROUPS=Engineering|Ops
ALLOWED_GROUPS=

# Groups that receive admin access to the portal (pipe-separated, same syntax as ALLOWED_GROUPS).
# Example: ADMIN_GROUP=Admins|Ops
ADMIN_GROUP=portal-admins

# Artifactory Configuration
# All three vars are required — the server talks to the Artifactory REST API
# directly (HEAD to check, PUT to upload); there is no mock fallback and no
# jf CLI dependency. Uploaded npm packages land in registry layout:
#   <repo>/<name>/-/<name>-<version>.tgz
# ARTIFACTORY_REPO is the npm repo and the fallback for anything unrecognised;
# other package types go to the per-type repos below.
# ARTIFACTORY_URL may be the platform base URL or the /artifactory service URL.
# In production (k8s) these come from a ConfigMap / Secret
ARTIFACTORY_URL=https://artifactory.example.com
ARTIFACTORY_REPO=my-local-repo
ARTIFACTORY_TOKEN=

# Docker repo (same Artifactory instance) that the Whitening module retags
# and pushes packed images to via skopeo. Leave unset if you never drop a
# pack containing an images/ folder.
ARTIFACTORY_DOCKER_REPO=

# Per-type repos (same Artifactory instance). JFrog indexes each package type in
# its own repo, so a .jar cannot land in the npm repo above. The module detects
# the type from the file and routes it here; leave a var unset and matching files
# are skipped with a log line rather than failing the job.
#   ARTIFACTORY_MAVEN_REPO  .jar/.pom/.war/.aar + checksums, uploaded in the
#     repository layout they arrive in — drop a ~/.m2/repository subtree, or
#     `mvn dependency:copy-dependencies -Dmdep.useRepositoryLayout=true` output.
#     A flat folder of jars is skipped: nothing in a jar's name gives its groupId.
#   ARTIFACTORY_RPM_REPO    .rpm, flat — Artifactory's YUM indexer reads the header
#   ARTIFACTORY_PYPI_REPO   .whl and name-version.tar.gz sdists, flat
#   ARTIFACTORY_CONDA_REPO  .conda/.tar.bz2 under their channel subdir
#     (linux-64, noarch, ...), taken from the folder they sit in
ARTIFACTORY_MAVEN_REPO=
ARTIFACTORY_RPM_REPO=
ARTIFACTORY_PYPI_REPO=
ARTIFACTORY_CONDA_REPO=

# Git (Bitbucket Server / Data Center) Configuration — used by the Whitening
# module to open pull requests from an unpacked pack's repository/{repository}/
# folder. {team} from repository/config.json is the Bitbucket PROJECT KEY and
# {repository} is the repo slug.
# GIT_URL: base URL of the closed-network Bitbucket — clone URLs are
#   {GIT_URL}/scm/{project}/{repo}.git and the REST API is at
#   {GIT_URL}/rest/api/1.0. Do NOT include either suffix here.
# GIT_USERNAME: leave empty unless your instance requires basic auth. Empty
#   means the HTTP access token goes into the clone URL on its own, which is
#   Bitbucket's documented token form. If set, the clone URL becomes
#   {username}:{token}@.
# GIT_TOKEN: a Bitbucket HTTP access token with write access to those repos.
#   This is the only auth the closed-network git gets: it goes into the clone
#   URL for git push and into "Authorization: Bearer" for the REST API — no SSH
#   keys, no interactive login. It IS a real credential: in k8s put it in the
#   devops-portal-secrets Secret (envFrom secretRef in the chart's
#   deployment.yaml), never in the ConfigMap or values.yaml.
GIT_URL=
GIT_USERNAME=
GIT_TOKEN=

# Jira Data Center Ticketing Configuration
# All three vars are required to use the real Jira backend; otherwise the
# server falls back to the in-memory ticketing store.
# JIRA_URL: base URL of the Jira Data Center instance — /rest/api/2 is appended automatically
# JIRA_TOKEN: a Personal Access Token (sent as "Authorization: Bearer <token>")
# JIRA_PROJECT_KEY: the project key new tickets are created under (e.g. DEVOPS)
JIRA_URL=
JIRA_TOKEN=
JIRA_PROJECT_KEY=

# JIRA_BOARD_ID: Agile board ID whose active sprint scopes the admin queue
#   (find it in the board URL: .../secure/RapidBoard.jspa?rapidView=<ID>).
#   If unset, the admin queue skips sprint filtering (shows all sprints).
# JIRA_MAINTENANCE_ISSUE_TYPE: issue type name marking DevOps maintenance
#   work (default: "Maintenance")
JIRA_BOARD_ID=
JIRA_MAINTENANCE_ISSUE_TYPE=Maintenance

# JIRA_STORY_POINTS_FIELD: custom-field id holding story points, e.g.
# customfield_10016 — instance-specific, find it via /rest/api/2/field.
# Unset = story points stay in the portal only and are not synced to Jira.
JIRA_STORY_POINTS_FIELD=

# Chat / AI Assistant Configuration
# Any OpenAI-compatible API (Groq, Ollama, OpenRouter, RAGFlow, etc.)
# CHAT_API_URL: base URL — /chat/completions is appended automatically
#   Groq:    https://api.groq.com/openai/v1
#   Ollama:  http://localhost:11434/v1
#   RAGFlow: https://ragflow.example.com/api/v1/openai/<chat-id>
# CHAT_MODEL: defaults to gpt-4o-mini if omitted
CHAT_API_URL=
CHAT_API_KEY=
CHAT_MODEL=llama-3.1-8b-instant
