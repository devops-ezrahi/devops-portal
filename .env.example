# SSO Configuration
# When SSO_REQUIRED=true the server rejects requests that lack SSO proxy headers
# In production (k8s) this comes from a ConfigMap; keep false for local dev
SSO_REQUIRED=false

# URL to redirect users to when not authenticated (only used client-side)
SSO_URL=

# Groups allowed to access the portal at all (pipe-separated; leave empty to allow everyone).
# Use plain group names, even if your IdP's groups claim sends full DNs
# (CN=Engineering,OU=Groups,DC=example,DC=com) — auth.ts extracts just the CN
# from the incoming header for matching, so the config side only needs the name.
# Example: ALLOWED_GROUPS=Engineering|Ops
ALLOWED_GROUPS=

# Groups that receive admin access to the portal (pipe-separated, same syntax as ALLOWED_GROUPS).
# Example: ADMIN_GROUP=Admins|Ops
ADMIN_GROUP=portal-admins

# Artifactory Configuration
# All three vars are required — the server uses jf CLI for all operations (no mock fallback)
# In production (k8s) these come from a ConfigMap / Secret
ARTIFACTORY_URL=https://artifactory.example.com
ARTIFACTORY_REPO=my-local-repo
ARTIFACTORY_TOKEN=

# Docker repo (same Artifactory instance) that the Whitening module retags
# and pushes packed images to via skopeo. Leave unset if you never drop a
# pack containing an images/ folder.
ARTIFACTORY_DOCKER_REPO=

# Git (Gitea) Configuration — used by the Whitening module to open pull
# requests from an unpacked pack's repository/{repository}/ folder, against
# {owner}/{repo} = {team}/{repository} from repository/config.json.
# GIT_URL: base URL of the closed-network Gitea — git clone URLs are
#   {GIT_URL}/scm/{owner}/{repo}.git (the REST API stays at {GIT_URL}/api/v1)
# GIT_USERNAME: username put in the authenticated clone URL alongside the
#   token (default: oauth2). Only change it if your git rejects that name.
# GIT_TOKEN: a Gitea personal access token with write access to those repos.
#   This is the only auth the closed-network git gets: it goes into the clone
#   URL for git push and into "Authorization: token" for the API — no SSH keys,
#   no interactive login. It IS a real credential: in k8s put it in the
#   devops-portal-secrets Secret (envFrom secretRef in the chart's
#   deployment.yaml), never in the ConfigMap or values.yaml.
GIT_URL=
GIT_USERNAME=oauth2
GIT_TOKEN=

# Jira Data Center Ticketing Configuration
# All three vars are required to use the real Jira backend; otherwise the
# server falls back to the in-memory ticketing store.
# JIRA_URL: base URL of the Jira Data Center instance — /rest/api/2 is appended automatically
# JIRA_TOKEN: a Personal Access Token (sent as "Authorization: Bearer <token>")
# JIRA_PROJECT_KEY: the project key new tickets are created under (e.g. DEVOPS)
JIRA_URL=
JIRA_TOKEN=
JIRA_PROJECT_KEY=

# JIRA_BOARD_ID: Agile board ID whose active sprint scopes the admin queue
#   (find it in the board URL: .../secure/RapidBoard.jspa?rapidView=<ID>).
#   If unset, the admin queue skips sprint filtering (shows all sprints).
# JIRA_MAINTENANCE_ISSUE_TYPE: issue type name marking DevOps maintenance
#   work (default: "Maintenance")
JIRA_BOARD_ID=
JIRA_MAINTENANCE_ISSUE_TYPE=Maintenance

# Chat / AI Assistant Configuration
# Any OpenAI-compatible API (Groq, Ollama, OpenRouter, RAGFlow, etc.)
# CHAT_API_URL: base URL — /chat/completions is appended automatically
#   Groq:    https://api.groq.com/openai/v1
#   Ollama:  http://localhost:11434/v1
#   RAGFlow: https://ragflow.example.com/api/v1/openai/<chat-id>
# CHAT_MODEL: defaults to gpt-4o-mini if omitted
CHAT_API_URL=
CHAT_API_KEY=
CHAT_MODEL=llama-3.1-8b-instant
